# tools/yeniden-uret.sh tarifi — konteyner gidince git dışı büyük dosyaları (wav, mp4) yeniden üretir.
# Biçim: her satır "<üretilen dosya (repo köküne göre)> | <komut>" — dosya varsa ve boş değilse adım atlanır.
# Komutlar repo kökünde çalışır; $PY = Whisper/görsel venv, $TTS_PY = Kokoro venv. Sıra önemlidir (bağımlılık sırası).
# Örnek (1929 tarifi: uretim/2026-10-26-1929-1000-dolar/yeniden-uret.adimlar):
# uretim/<klasör>/04-ses/anlatim.wav | ffmpeg -v error -y -i uretim/<klasör>/04-ses/anlatim.m4a -c:a pcm_f32le uretim/<klasör>/04-ses/anlatim.wav
# uretim/<klasör>/08-kurgu/final-16x9.mp4 | tools/render-parca.sh <Kisa>Final uretim/<klasör>/08-kurgu/final-16x9.mp4 --ses <miks.wav>
uretim/2026-10-28-yeni-video/04-ses/anlatim.wav | ffmpeg -v error -y -i uretim/2026-10-28-yeni-video/04-ses/anlatim.m4a -c:a pcm_s24le uretim/2026-10-28-yeni-video/04-ses/anlatim.wav
uretim/2026-10-28-yeni-video/04-ses/shorts-1-ek.wav | ffmpeg -v error -y -i uretim/2026-10-28-yeni-video/04-ses/shorts-1-ek.m4a -c:a pcm_s24le uretim/2026-10-28-yeni-video/04-ses/shorts-1-ek.wav
uretim/2026-10-28-yeni-video/04-ses/shorts-2-ek.wav | ffmpeg -v error -y -i uretim/2026-10-28-yeni-video/04-ses/shorts-2-ek.m4a -c:a pcm_s24le uretim/2026-10-28-yeni-video/04-ses/shorts-2-ek.wav
uretim/2026-10-28-yeni-video/04-ses/rhubarb/S01.wav | python3 -I tools/ses/rhubarb-hazirla.py --dizin uretim/2026-10-28-yeni-video/04-ses
# F5 animasyon (animasyon-yonetmeni): varlıklar + Rhubarb + veri + render
video/public/kbutce/G01.jpg | $PY -I uretim/2026-10-28-yeni-video/07-animasyon/varlik-hazirla.py
video/public/kbutce/leo-G05k.png | $PY -I uretim/2026-10-28-yeni-video/07-animasyon/g05-boya.py
uretim/2026-10-28-yeni-video/07-animasyon/rhubarb/tum-kapili.json | python3 -I tools/animasyon/rhubarb-toplu.py --girdi uretim/2026-10-28-yeni-video/04-ses/rhubarb/sahneler.json --cikis uretim/2026-10-28-yeni-video/07-animasyon/rhubarb --ek shorts-1-ek:uretim/2026-10-28-yeni-video/04-ses/shorts-1-ek.wav:uretim/2026-10-28-yeni-video/07-animasyon/rhubarb/ek/shorts-1-ek.txt --ek shorts-2-ek:uretim/2026-10-28-yeni-video/04-ses/shorts-2-ek.wav:uretim/2026-10-28-yeni-video/07-animasyon/rhubarb/ek/shorts-2-ek.txt
uretim/2026-10-28-yeni-video/07-animasyon/test-10sn.mp4 | tools/render-son.sh KButceKritik uretim/2026-10-28-yeni-video/07-animasyon/test-10sn.mp4
uretim/2026-10-28-yeni-video/07-animasyon/tam-16x9.mp4 | tools/render-parca.sh KButceTam uretim/2026-10-28-yeni-video/07-animasyon/tam-16x9.mp4
# F7 kurgu (kurgu-editoru): kurgu-veri.ts git içinde; miks + yataklar + render git dışı
${KURGU_CIKIS:-$HOME/.finansal-arac/kurgu-kbutce}/final-miks.wav | $PY uretim/2026-10-28-yeni-video/08-kurgu/kurgu_ses.py ana
video/public/kbutce/sh1-yatak.wav | $PY uretim/2026-10-28-yeni-video/08-kurgu/kurgu_ses.py shorts
uretim/2026-10-28-yeni-video/08-kurgu/final-16x9.mp4 | tools/render-parca.sh KButceFinal uretim/2026-10-28-yeni-video/08-kurgu/final-16x9.mp4 --kaynak KButceTam --ses ${KURGU_CIKIS:-$HOME/.finansal-arac/kurgu-kbutce}/final-miks.wav
uretim/2026-10-28-yeni-video/08-kurgu/shorts-1.mp4 | tools/render-son.sh KButceShorts1 uretim/2026-10-28-yeni-video/08-kurgu/shorts-1.mp4
uretim/2026-10-28-yeni-video/08-kurgu/shorts-2.mp4 | tools/render-son.sh KButceShorts2 uretim/2026-10-28-yeni-video/08-kurgu/shorts-2.mp4
